# Gateway
GATEWAY_PORT=8080
CORE_SERVICE_URL=http://core-service:8081
UPSTREAM_TIMEOUT_MS=5000
UPSTREAM_RETRIES=2
LOG_LEVEL=info

# Core service
SPRING_PROFILES_ACTIVE=prod
CORE_SERVICE_PORT=8081
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ecommerce
SPRING_DATASOURCE_USERNAME=ecommerce
SPRING_DATASOURCE_PASSWORD=change-me
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me

# Email verification (US-001)
VERIFICATION_TOKEN_TTL=PT24H
VERIFICATION_LINK_BASE_URL=http://localhost:3000/verify-email
RESEND_COOLDOWN=PT60S
RESEND_MAX_ATTEMPTS=5
SESSION_TTL=PT1H
POST_VERIFICATION_REDIRECT=/dashboard
BCRYPT_STRENGTH=12

# JWT (RS256). Leave paths empty to use an ephemeral key pair (dev only).
JWT_ISSUER=ecommerce-core-service
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# External notification service. Leave empty to log emails instead of sending (dev only).
NOTIFICATION_SERVICE_URL=
NOTIFICATION_FROM_ADDRESS=no-reply@example.com
NOTIFICATION_TIMEOUT=PT5S
