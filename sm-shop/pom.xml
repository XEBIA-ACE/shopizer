<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal sm-shop POM fragment that adds the Caffeine dependency required by CacheConfig.
  In the real Shopizer project this file already exists with many more entries; this
  snippet shows only the dependency block that must be present (or merged in) to satisfy
  TASK-004.  The spring-boot-starter-cache transitive pull-in of the Spring Cache
  abstraction is assumed to be present via the existing spring-boot-starter-web / parent.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.salesmanager</groupId>
        <artifactId>shopizer</artifactId>
        <version>3.2.5</version>
    </parent>

    <artifactId>sm-shop</artifactId>
    <packaging>war</packaging>
    <name>sm-shop</name>

    <dependencies>

        <!-- ============================================================
             Spring Cache abstraction (included transitively via
             spring-boot-starter-web in most Shopizer builds, but listed
             explicitly here for clarity).
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- ============================================================
             Caffeine — high-performance, near-optimal caching library.
             Required by CacheConfig (CaffeineCacheManager).
             Version is managed by the Spring Boot BOM; no explicit
             version needed when the Boot parent is on the classpath.
             ============================================================ -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <!-- version intentionally omitted — managed by Spring Boot BOM -->
        </dependency>

    </dependencies>

</project>
